# ─── Trello credentials (https://trello.com/power-ups/admin) ──────────────────
TRELLO_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-api-token

# ─── Trello identifiers ───────────────────────────────────────────────────────
# Board that the webhook is registered on and that the automation watches.
TRELLO_BOARD_ID=your-board-id
# Your Trello member id (the person who gets added to cards).
TRELLO_MEMBER_ID=your-member-id
# The three lists that matter. Only these are used — everything else is ignored.
TODO_LIST_ID=your-todo-list-id
DOING_LIST_ID=your-doing-list-id
CODE_REVIEW_LIST_ID=your-code-review-list-id

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and the server-side SECRET key (Settings → API Keys). The secret
# key is the only credential the service uses; it bypasses RLS, so the tables
# are locked down to it alone (see supabase/schema.sql).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Webhook / admin ──────────────────────────────────────────────────────────
# Embedded in the webhook callback URL path and required on /api/trello/setup
# and /api/trello/status as the `x-admin-token` header. Long random string
# (generate with `npm run secret`).
WEBHOOK_SECRET=generate-a-long-random-string
# Public base URL of the deployed app (used to register the Trello webhook).
APP_BASE_URL=https://your-app.vercel.app
