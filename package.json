{
  "name": "trello-auto-claim",
  "version": "0.1.0",
  "private": true,
  "description": "Single-purpose Trello automation: claim an eligible, unclaimed card the moment it enters the configured To Do list.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "board": "node --env-file-if-exists=.env.local scripts/resolve-board.mjs"
  },
  "dependencies": {
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
